# Added automatically by the Vercel Neon integration. Keep private.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Added automatically by the Vercel Neon integration. Keep private.
NEON_AUTH_BASE_URL="https://your-project.neonauth.region.aws.neon.tech/neondb/auth"

# Generate once with a cryptographically secure random value. Add it as a Vercel Secret
# in Production, Preview, and Development; never expose it to the browser.
NEON_AUTH_COOKIE_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Local development only — never add these to Vercel. They unlock the local
# development sign-in panel and may be changed to any private values.
SFA_DEV_LOGIN_EMAIL="developer@sfa.local"
SFA_DEV_LOGIN_PASSWORD="SFA-Local-Dev-2026!"
